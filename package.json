{
  "name": "speak-like-you-eat",
  "version": "1.1.0",
  "description": "A Pi and Oh My Pi extension for plain-language companion rewrites.",
  "author": "wtfzambo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wtfzambo/speak-like-you-eat.git"
  },
  "homepage": "https://github.com/wtfzambo/speak-like-you-eat#readme",
  "bugs": "https://github.com/wtfzambo/speak-like-you-eat/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "omp",
    "oh-my-pi",
    "plain-language",
    "writing",
    "rewrite"
  ],
  "files": [
    "src",
    "imgs/front.png",
    "README.md",
    "backlog/docs/specs/doc-1 - SLYE-MVP-specification.md",
    "backlog/docs/specs/doc-4 - SLYE-benchmark-results.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/wtfzambo/speak-like-you-eat/refs/heads/main/imgs/front.png"
  },
  "omp": {
    "extensions": [
      "./src/omp.ts"
    ],
    "image": "https://raw.githubusercontent.com/wtfzambo/speak-like-you-eat/refs/heads/main/imgs/front.png"
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "biome:check": "biome check .",
    "typecheck": "tsc",
    "test": "node --test",
    "check": "npm run biome:check && npm run typecheck && npm test",
    "benchmark:dry-run": "node benchmark/cli.ts dry-run",
    "benchmark:run": "node benchmark/cli.ts run",
    "benchmark:report": "node benchmark/cli.ts report",
    "benchmark:phase-2:dry-run": "node benchmark/cli.ts phase-2-dry-run",
    "benchmark:phase-2:run": "node benchmark/cli.ts phase-2-run",
    "benchmark:phase-2:report": "node benchmark/cli.ts phase-2-report"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "^24.0.0",
    "lefthook": "2.1.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
